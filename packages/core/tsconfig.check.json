{
  // Type checking only, as in apps/server and apps/agent (#26). tsx reads tsconfig.json at run time and would follow
  // these paths to the SDK's declaration file instead of its code.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Like the @bsv/sdk alias in vitest.config.ts: wallet-toolbox (CommonJS) gets the SDK's CJS declarations, so ours
    // must come from the same build, or its classes exist twice and do not match.
    "paths": {
      "@bsv/sdk": ["../../node_modules/@bsv/sdk/dist/cjs/mod.d.ts"]
    }
  }
}
