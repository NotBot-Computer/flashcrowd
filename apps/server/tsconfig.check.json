{
  // Type checking only. tsx reads tsconfig.json at run time and would follow these paths to the wrong build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // As in packages/core: wallet-toolbox (CommonJS) gets the SDK's CJS declarations, so ours must match.
    "paths": {
      "@bsv/sdk": ["../../node_modules/@bsv/sdk/dist/cjs/mod.d.ts"]
    }
  },
  "include": ["src", "test"]
}
