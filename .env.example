# Copy to .env (gitignored). Real keys never go anywhere in the repo.

# testnet | mainnet
BSV_NETWORK=testnet

# apps/server
SERVER_PORT=8787
# Key files outside the repo, created by: npm run wallet:init -w @agentswap/server
# The coordinator's BRC-103 identity (signs messages, holds no coins)
SERVER_KEY_FILE=
# The mock seller's wallet (receives the claims, needs no funds)
SELLER_KEY_FILE=
# State, the seller's secrets and its wallet database; defaults to ~/.agentswap/server-data
SERVER_DATA_DIR=
# refundHeight = height at matching + this (above 2)
SELLER_LOCK_BLOCKS=6
# true for the refund demo: the seller never claims
SELLER_NO_CLAIM=false

# apps/agent
SERVER_URL=http://localhost:8787
# The agents' key files, outside the repo: npm run wallet:init -w @agentswap/agent -- ~/.agentswap/agent-1.key
# Either a directory with agent-1.key … agent-N.key (used with --agents N) or a comma-separated list of files
AGENT_KEY_DIR=~/.agentswap
AGENT_KEY_FILES=
# The most each agent offers, one value for all or one per agent (whole sats)
AGENT_MAX_CONTRIBUTIONS=3000,4000,5000
# Spend policy, checked in code before every signature (whole sats, blocks)
AGENT_MAX_PER_PURCHASE_SATS=6000
AGENT_MAX_TOTAL_SATS=20000
AGENT_MAX_LOCK_BLOCKS=30
# The mock seller's service in apps/server
AGENT_SERVICE_ID=bsv-usd-closes
AGENT_RESOURCE_ID=bsvusd-2026-10
# Comma-separated; defaults to AGENT_SERVICE_ID
AGENT_ALLOWED_SERVICES=
# Claude API key for the agent's LLM (or sign in once with `ant auth login`)
ANTHROPIC_API_KEY=
